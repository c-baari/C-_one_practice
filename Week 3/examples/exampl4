int day = 3;

//switch
// Check the value of day
switch (day)
{
    case 1:
        MessageBox.Show("Monday");
        break;

    case 2:
        MessageBox.Show("Tuesday");
        break;

    case 3:
        MessageBox.Show("Wednesday");
        break;

    case 4:
        MessageBox.Show("Thursday");
        break;

    case 5:
        MessageBox.Show("Friday");
        break;

    default:
        MessageBox.Show("Invalid Day");
        break;
}